# Comments go on their own lines: systemd's EnvironmentFile keeps anything after
# the `=` (including a trailing `# ...`) as part of the value.

# required, secret. Never commit.
# DISCORD_TOKEN=
LOG_LEVEL=info
COMMAND_PREFIX=!
ECHO_COMMAND_NAME=echo
ECHO_MAX_LENGTH=1900
SHUTDOWN_TIMEOUT_MS=5000
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8081

# OCR (shopping list photo recognition)
# optional, default none; set to gcp-vision to enable recognition
OCR_PROVIDER=
# required iff OCR_PROVIDER=gcp-vision; path to service-account JSON key (path may be logged, key contents never)
GCP_SA_KEY_PATH=
# optional, comma-separated loose BCP-47 tags (e.g. en,de,zh-Hans); omit = provider auto-detect
# OCR_LANGUAGE_HINTS=
# optional, comma-separated 17-20 digit channel snowflakes; omit = every visible channel is processed
# OCR_CHANNEL_ALLOWLIST=

# AI list sorting (groups recognized lines by shop-walk order)
# optional; empty = sorting off (verbatim reply). e.g. anthropic:claude-haiku-5-5
SORTING_MODEL=
# optional https URL; https://opencode.ai/inference/anthropic routes through OpenCode
SORTING_BASE_URL=
# required iff SORTING_MODEL is set; secret (OpenCode key when routed through OpenCode). Never commit.
SORTING_API_KEY=

# Step tracing (LangSmith). Traces CONTAIN LIST TEXT. On by default for the test period;
# issue #16 switches the default off afterwards.
# optional, langsmith (default) or off
# TRACING=
# secret; empty = bot runs untraced and logs one startup warning. Never commit.
LANGSMITH_API_KEY=
# optional, default empty-cart
# LANGSMITH_PROJECT=
# Do NOT set LANGSMITH_TRACING for the bot: LangChain would add its own tracer and trace every run twice.
# It is only for `npm run eval`.
