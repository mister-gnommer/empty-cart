# Every variable, with its default. Full reference: docs/deployment.md §4.
# Comments go on their own lines: systemd's EnvironmentFile keeps anything after
# the `=` (including a trailing `# ...`) as part of the value.

# Discord: required, secret. Never commit.
# DISCORD_TOKEN=

# Core (optional; these are the defaults)
LOG_LEVEL=info
COMMAND_PREFIX=!
ECHO_COMMAND_NAME=echo
ECHO_MAX_LENGTH=1900
SHUTDOWN_TIMEOUT_MS=5000
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8081

# Photo recognition. Blank = off; gcp-vision to enable.
OCR_PROVIDER=
# required iff OCR_PROVIDER=gcp-vision; path to the service-account JSON key (the path may be logged, the contents never)
GCP_SA_KEY_PATH=
# optional, comma-separated loose BCP-47 tags (e.g. en,de,zh-Hans); omit = provider auto-detect
# OCR_LANGUAGE_HINTS=
# optional, comma-separated 17-20 digit channel ids; omit = every visible channel. Blank is rejected.
# OCR_CHANNEL_ALLOWLIST=

# List sorting. Blank = off. e.g. anthropic:claude-haiku-5-5
SORTING_MODEL=
# optional https URL; blank = Anthropic's API. Gateways: https://opencode.ai/inference/anthropic, https://openrouter.ai/api
SORTING_BASE_URL=
# required iff SORTING_MODEL is set; the key for the provider or gateway above. Secret, never commit.
SORTING_API_KEY=

# Tracing (LangSmith). Traces CONTAIN LIST TEXT. On by default for the test period (issue #16).
# optional, langsmith (default) or off
# TRACING=
# secret; blank = untraced, with one startup warning. Never commit.
LANGSMITH_API_KEY=
# optional, default empty-cart; blank is rejected
# LANGSMITH_PROJECT=
# Never set LANGSMITH_TRACING here: the bot would trace every run twice.
# Pass it on the eval command line only: LANGSMITH_TRACING=true npm run eval
