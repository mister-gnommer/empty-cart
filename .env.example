# DISCORD_TOKEN=        # required, secret. Never commit.
LOG_LEVEL=info
COMMAND_PREFIX=!
ECHO_COMMAND_NAME=echo
ECHO_MAX_LENGTH=1900
SHUTDOWN_TIMEOUT_MS=5000
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8081

# OCR (shopping list photo recognition)
OCR_PROVIDER=            # optional, default none; set to gcp-vision to enable recognition
GCP_SA_KEY_PATH=         # required iff OCR_PROVIDER=gcp-vision; path to service-account JSON key (path may be logged, key contents never)
# OCR_LANGUAGE_HINTS=    # optional, comma-separated loose BCP-47 tags (e.g. en,de,zh-Hans); omit = provider auto-detect
# OCR_CHANNEL_ALLOWLIST= # optional, comma-separated 17-20 digit channel snowflakes; omit = every visible channel is processed