{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "tests/**/*.ts", "evals/**/*.ts", "*.config.*", "*.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "discord.js": "Only src/discord may import discord.js.",
              "pino": "Only src/config and src/logger may import pino.",
              "zod": "Only src/config may import zod.",
              "@google-cloud/vision": "Only src/ocr/google-vision may import @google-cloud/vision.",
              "langchain": "Only src/categorizer may import langchain.",
              "@langchain/core": "Only src/categorizer, src/tracing and (type-only) src/shopping-list may import @langchain/core.",
              "@langchain/anthropic": "Only src/categorizer may import @langchain/anthropic.",
              "@langchain/langgraph": "Only src/shopping-list may import @langchain/langgraph.",
              "langsmith": "Only src/tracing may import langsmith."
            },
            "patterns": [
              {
                "group": ["langchain/**"],
                "message": "Only src/categorizer may import langchain."
              },
              {
                "group": ["@langchain/core/**"],
                "message": "Only src/categorizer, src/tracing and (type-only) src/shopping-list may import @langchain/core."
              },
              {
                "group": ["@langchain/anthropic/**"],
                "message": "Only src/categorizer may import @langchain/anthropic."
              },
              {
                "group": ["@langchain/langgraph/**"],
                "message": "Only src/shopping-list may import @langchain/langgraph."
              },
              {
                "group": ["langsmith/**"],
                "message": "Only src/tracing may import langsmith."
              }
            ]
          }
        }
      }
    }
  },
