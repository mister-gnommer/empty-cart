{
  "name": "empty-cart",
  "version": "1.0.0",
  "private": true,
  "description": "VPS-hosted Discord bot skeleton (001-vps-discord-bot)",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "eval": "vitest run -c vitest.eval.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "health": "node dist/health-cli.js"
  },
  "dependencies": {
    "@google-cloud/vision": "6.1.0",
    "@langchain/anthropic": "1.6.0",
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "discord.js": "14.27.0",
    "langchain": "1.6.0",
    "langsmith": "0.11.6",
    "pino": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
