{
  "name": "empty-cart",
  "version": "1.0.0",
  "private": true,
  "description": "VPS-hosted Discord bot skeleton (001-vps-discord-bot)",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "health": "node dist/health-cli.js"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
